            </div>
            
            <section class="s_three_columns o_cc o_cc2 pt32 pb32 o_colored_level" data-vxml="001" data-vcss="001" data-snippet="s_three_columns" data-name="Columns">
                <div class="container">
                    <div class="row d-flex align-items-stretch">
                        <div data-name="Card" class="pb16 pt16 col-lg-4">
